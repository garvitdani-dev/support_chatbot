# Configure these before starting the API.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# JSON mapping of bearer tokens to allowed tenant IDs. Never commit real tokens.
SUPPORT_API_TOKENS='{"replace-with-long-random-token":["spring-garden"]}'
TENANTS_ROOT=data/tenants
MAX_RETRIEVAL_ITERATIONS=3
MAX_TOOL_CALLS=12
RETRIEVAL_TOP_K=12
RERANK_TOP_K=6
MAX_EVIDENCE_CHARS=24000
OPENAI_TIMEOUT_SECONDS=45
MAX_UPLOAD_BYTES=20971520
